        {
          "id": 1,
          "keys": [],
          "secondary_keys": [],
          "comment": "Slice of life (nar_genre_slice_of_life)",
          "name": "Slice of life",
          "content": "{{if .nar_genre_slice_of_life}}Slice-of-life craft: nothing needs to be at stake for a scene to matter. Stay with small things: food, weather, routines, what someone almost said. Do not invent danger, villains or twists. Let scenes breathe and end softly; progress is a relationship shifting by a degree or a small plan coming together.{{/if}}",
          "constant": true,
          "selective": false,
          "insertion_order": 101,
          "enabled": true,
          "position": "after_char",
          "use_regex": false,
          "extensions": {

        {
          "id": 3,
          "keys": [],
          "secondary_keys": [],
          "comment": "Horror (nar_genre_horror)",
          "name": "Horror",
          "content": "{{if .nar_genre_horror}}Horror craft: dread comes from what is withheld. Show the wrong detail, not the monster; let ordinary things turn. Escalate slowly, and give quiet stretches so the next disturbance lands. Safety is always partial. Do not explain the threat fully, and do not release tension with jokes unless a character would.{{/if}}",
          "constant": true,
          "selective": false,
          "insertion_order": 103,
          "enabled": true,
          "position": "after_char",
          "use_regex": false,
          "extensions": {

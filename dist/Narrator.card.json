        {
          "id": 5,
          "keys": [],
          "secondary_keys": [],
          "comment": "Romance (nar_genre_romance)",
          "name": "Romance",
          "content": "{{if .nar_genre_romance}}Romance craft: attraction lives in attention: who is noticed, remembered, waited for. Move by small, reversible steps and let each character want something of their own besides the other person. Keep tension in what is unsaid. Feelings follow the relationship as established; never leap ahead of it.{{/if}}",
          "constant": true,
          "selective": false,

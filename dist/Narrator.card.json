        {
          "id": 4,
          "keys": [],
          "secondary_keys": [],
          "comment": "Mystery (nar_genre_mystery)",
          "name": "Mystery",
          "content": "{{if .nar_genre_mystery}}Mystery craft: play fair. Every answer the story will give must be reachable from things the player can find. Present clues as plain observations, never as conclusions; witnesses have reasons to shade the truth. Do not solve anything for the player, and do not hide a clue behind a single door.{{/if}}",
          "constant": true,
          "selective": false,

        {
          "id": 2,
          "keys": [],
          "secondary_keys": [],
          "comment": "Survival (nar_genre_survival)",
          "name": "Survival",
          "content": "{{if .nar_genre_survival}}Survival craft: scarcity is the antagonist. Keep supplies, shelter, injury, weather and daylight concrete and consistent from scene to scene. Choices cost something and consequences arrive on time, without cruelty and without rescue. Never soften a loss the story has earned, and never push the player toward one option.{{/if}}",
          "constant": true,
          "selective": false,
          "insertion_order": 102,
          "enabled": true,
          "position": "after_char",
          "use_regex": false,
          "extensions": {
